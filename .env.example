SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_TO=you@gmail.com
EMAIL_FROM=you@gmail.com

# Apify — optional. Without APIFY_TOKEN, apify-refresh is a no-op.
APIFY_TOKEN=
APIFY_MAX_SPEND_PER_MONTH=4.20
APIFY_MAX_RUNS_PER_MONTH=90
APIFY_MIN_HOURS_BETWEEN_RUNS=6
